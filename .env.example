MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000

# Auth
JWT_SECRET=<use a long random string>
JWT_EXPIRES_IN=7d

# Transactional email (Resend) — required for verification/reset emails.
# If any of these are missing/invalid, email sending is disabled at boot
# (see validateEmailConfig in src/utils/email.service.js) but the server
# still starts.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Jobton <noreply@jobton.com.ng>
RESEND_TO_EMAIL=<fallback-bcc-recipient@jobton.com.ng>

# FRONTEND_URL must be a single plain URL — it's used to build the
# verification/reset links sent in emails (see email.service.js).
FRONTEND_URL=http://localhost:5173

# Optional, CORS-only allow-list (see app.js) — comma-separated, no trailing
# slashes (an Origin header never has one). Falls back to FRONTEND_URL alone
# if unset. Set this when more than one origin needs to call the API, e.g.
# local dev plus the deployed frontend:
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jobton.com.ng
