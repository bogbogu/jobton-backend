MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000

# Auth
JWT_SECRET=<use a long random string>
JWT_EXPIRES_IN=7d

# Number of reverse proxies in front of the app (e.g. Cloudflare + Render). Lets the
# rate limiters see each visitor's real IP. Leave unset locally. Never use "true".
# TRUST_PROXY_HOPS=2

# Transactional email (Resend) — required for verification/reset emails.
# If any of these are missing/invalid, email sending is disabled at boot
# (see validateEmailConfig in src/utils/email.service.js) but the server
# still starts.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Jobton <noreply@jobton.com.ng>

# FRONTEND_URL must be a single plain URL — it's used to build the
# verification/reset links sent in emails (see email.service.js).
FRONTEND_URL=http://localhost:5173

# Optional, CORS-only allow-list (see app.js) — comma-separated, no trailing
# slashes (an Origin header never has one). Falls back to FRONTEND_URL alone
# if unset. Set this when more than one origin needs to call the API, e.g.
# local dev plus the deployed frontend:
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jobton.com.ng

# Telegram ingestion (npm run ingest) — placeholders only, never commit a real key.
# Ingestion does nothing unless INGESTION_ENABLED is exactly "true". Ingested
# jobs always land in "pending_review"; an admin publishes them.
ANTHROPIC_API_KEY=
INGESTION_ENABLED=false
INGESTION_MODEL=claude-haiku-5-5
# Hard ceiling on LLM calls per UTC day, across all runs.
INGESTION_DAILY_LLM_CAP=300
# Posts sent to the LLM per channel per run.
INGESTION_MAX_POSTS_PER_CHANNEL_RUN=40
# t.me pages fetched per channel per run (~20 posts each).
INGESTION_MAX_PAGES_PER_CHANNEL=3
# Stop extracting for a channel while this many of its jobs await review.
INGESTION_MAX_PENDING_PER_CHANNEL=200
# Pause between t.me requests, in milliseconds.
INGESTION_FETCH_DELAY_MS=2000

# Interactive API docs (Swagger UI at /api-docs, spec at /api-docs.json).
# OFF unless this is exactly "true". Keep it false on the public live API
# (or protect it); turn it on locally or on a private staging server.
API_DOCS_ENABLED=false
